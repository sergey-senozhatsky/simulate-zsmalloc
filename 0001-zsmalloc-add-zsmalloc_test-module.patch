From ed46b8cc8f94cb8c24268a9d2cdbc2f6e1dd9e9a Mon Sep 17 00:00:00 2001
From: Sergey Senozhatsky <senozhatsky@chromium.org>
Date: Tue, 30 Dec 2025 21:19:42 +0900
Subject: [PATCH] zsmalloc: add zsmalloc_test module

A simple module to generate byte-to-byte comparable
zsmalloc workloads.

Signed-off-by: Sergey Senozhatsky <senozhatsky@chromium.org>
---
 mm/Makefile        |   1 +
 mm/zsmalloc_test.c | 216 +++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 217 insertions(+)
 create mode 100644 mm/zsmalloc_test.c

diff --git a/mm/Makefile b/mm/Makefile
index b1963ccc74ac..7509d6416d06 100644
--- a/mm/Makefile
+++ b/mm/Makefile
@@ -120,6 +120,7 @@ obj-$(CONFIG_DEBUG_VM_PGTABLE) += debug_vm_pgtable.o
 obj-$(CONFIG_PAGE_OWNER) += page_owner.o
 obj-$(CONFIG_MEMORY_ISOLATION) += page_isolation.o
 obj-$(CONFIG_ZSMALLOC)	+= zsmalloc.o
+obj-$(CONFIG_ZSMALLOC)	+= zsmalloc_test.o
 obj-$(CONFIG_GENERIC_EARLY_IOREMAP) += early_ioremap.o
 obj-$(CONFIG_CMA)	+= cma.o
 obj-$(CONFIG_NUMA) += numa.o
diff --git a/mm/zsmalloc_test.c b/mm/zsmalloc_test.c
new file mode 100644
index 000000000000..0a140317da22
--- /dev/null
+++ b/mm/zsmalloc_test.c
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/zsmalloc.h>
+#include <linux/slab.h>
+#include <linux/mm.h>
+#include <linux/list.h>
+#include <linux/ktime.h>
+
+#define MIN_SIZE 32
+#define MIN_STEP_SIZE 1
+#define MAX_STEP_SIZE 127
+#define STEP_DELTA 8
+#define OBJS_PER_CLASS 182
+#define ZS_HANDLE_SIZE sizeof(unsigned long)
+
+struct test_obj {
+	unsigned long handle;
+	size_t size;
+	struct list_head list;
+};
+
+static LIST_HEAD(handles_list);
+static struct zs_pool *pool;
+
+static void free_objects(void)
+{
+	struct test_obj *obj, *tmp;
+
+	list_for_each_entry_safe(obj, tmp, &handles_list, list) {
+		zs_free(pool, obj->handle);
+		list_del(&obj->list);
+		kfree(obj);
+	}
+}
+
+static void fill_pattern(void *buf, size_t size, int count)
+{
+	u8 pattern = (u8)(count & 0xFF);
+
+	memset(buf, pattern, size);
+}
+
+static bool verify_pattern(void *buf, size_t size, int count)
+{
+	u8 pattern = (u8)(count & 0xFF);
+	size_t i;
+	u8 *byte_buf = buf;
+
+	for (i = 0; i < size; i++) {
+		if (byte_buf[i] != pattern) {
+			pr_err("expected 0x%02x, got 0x%02x at offt %zu\n",
+			       pattern, byte_buf[i], i);
+
+			print_hex_dump(KERN_ERR, "", DUMP_PREFIX_NONE, 16, 4,
+				       buf, size, true);
+			return false;
+		}
+	}
+
+	return true;
+}
+
+static int allocate_objects(void *local_copy, u32 step)
+{
+	u64 total_alloc_size = 0;
+	struct test_obj *obj;
+	ktime_t start, end;
+	int count = 0;
+	int i, sz;
+	s64 delta_us;
+	u32 ratio;
+
+	for (sz = MIN_SIZE; sz < zs_huge_class_size(pool); sz += step) {
+		for (i = 0; i < OBJS_PER_CLASS; i++) {
+			unsigned long handle;
+
+			handle = zs_malloc(pool, sz, GFP_KERNEL, 0);
+			if (!handle) {
+				pr_err("zs_malloc failed for size %d\n", sz);
+				return -ENOMEM;
+			}
+
+			obj = kmalloc(sizeof(*obj), GFP_KERNEL);
+			if (!obj) {
+				zs_free(pool, handle);
+				return -ENOMEM;
+			}
+
+			total_alloc_size += sz;
+			obj->handle = handle;
+			obj->size = sz;
+			list_add_tail(&obj->list, &handles_list);
+		}
+	}
+
+	start = ktime_get();
+
+	count = 0;
+	list_for_each_entry(obj, &handles_list, list) {
+		fill_pattern(local_copy, obj->size, count);
+		zs_obj_write(pool, obj->handle, local_copy, obj->size);
+		count++;
+	}
+
+	end = ktime_get();
+	delta_us = ktime_to_us(ktime_sub(end, start));
+
+	pr_info("num write objects: %d\n", count);
+	pr_info("pool pages used %lu, total allocated size %llu\n",
+		zs_get_total_pages(pool), total_alloc_size);
+
+	ratio = total_alloc_size * 1000 / (zs_get_total_pages(pool) * PAGE_SIZE);
+	pr_info("pool memory utilization: %u.%u\n", ratio / 10, ratio % 10);
+	pr_info("all write() completed in %lld us\n", delta_us);
+
+	return 0;
+}
+
+static int run_read_test(void *local_copy)
+{
+	struct test_obj *obj;
+	void *mapped_addr;
+	int count = 0;
+	ktime_t start, end;
+	s64 delta_us;
+	u64 total_memcpy_size = 0;
+	u32 spans_count = 0;
+
+	start = ktime_get();
+
+	list_for_each_entry(obj, &handles_list, list) {
+		mapped_addr = zs_obj_read_begin(pool, obj->handle,
+						obj->size, local_copy);
+
+		if (mapped_addr == (local_copy + ZS_HANDLE_SIZE)) {
+			spans_count++;
+			total_memcpy_size += obj->size;
+		}
+
+		if (!verify_pattern(mapped_addr, obj->size, count))
+			return -EINVAL;
+
+		zs_obj_read_end(pool, obj->handle, obj->size, mapped_addr);
+		count++;
+	}
+
+	end = ktime_get();
+	delta_us = ktime_to_us(ktime_sub(end, start));
+
+	pr_info("num read objects: %d\n", count);
+	pr_info("spanning objects: %u, total memcpy size: %llu\n", spans_count,
+		total_memcpy_size);
+	pr_info("all read() completed in %lld us\n", delta_us);
+
+	return 0;
+}
+
+static int run(u32 step)
+{
+	void *local_copy;
+	int err;
+
+	pool = zs_create_pool("test_pool");
+	if (!pool)
+		return -ENOMEM;
+
+	local_copy = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!local_copy) {
+		zs_destroy_pool(pool);
+		return -ENOMEM;
+	}
+	memset(local_copy, 0, PAGE_SIZE);
+
+	err = allocate_objects(local_copy, step);
+	if (err < 0)
+		goto cleanup;
+
+	err = run_read_test(local_copy);
+
+cleanup:
+	free_objects();
+	kfree(local_copy);
+	zs_destroy_pool(pool);
+	return err;
+}
+
+static int __init zsmalloc_test_init(void)
+{
+	u32 step;
+	int err;
+
+	for (step = MIN_STEP_SIZE; step <= MAX_STEP_SIZE; step += STEP_DELTA) {
+		pr_info("running test with step size: %u\n", step);
+		err = run(step);
+		if (err < 0) {
+			pr_err("test failed with step size: %u\n", step);
+			return err;
+		}
+	}
+	return 0;
+}
+
+static void __exit zsmalloc_test_exit(void)
+{
+	pr_info("module unloaded\n");
+}
+
+module_init(zsmalloc_test_init);
+module_exit(zsmalloc_test_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("zsmalloc test module");
-- 
